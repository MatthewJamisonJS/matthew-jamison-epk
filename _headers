# Cloudflare Pages headers. Applied at the edge only — a local static server
# ignores this file, so header audits must run against the deployed site.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # Enforcing. Four Cloudflare zone features inject script that cannot satisfy
  # this policy, and all four are off: Bot Fight Mode, JavaScript Detections
  # (inline + nonce-less + innerHTML), Email Address Obfuscation (its decoder
  # uses innerHTML, so with Trusted Types on it left mailto: links rendering as
  # broken placeholder text), and Rocket Loader. Turning any of them back on
  # breaks either that feature or this policy — Cloudflare's own answer is a
  # per-request CSP nonce, which _headers cannot mint (it would need a Pages
  # Function). Web Analytics is the exception: its beacon host is allowed below
  # rather than disabled.
  # Two sha256 sources, both for inline *data* blocks in index.html: the
  # application/ld+json block, and the application/json store-data block that
  # carries the track lists. Neither is executable, but both are pinned so the
  # policy stays honest — recompute a hash whenever its block's bytes change:
  #   python3 - <<'EOF'
  #   import re,hashlib,base64
  #   h=open('index.html',encoding='utf-8').read()
  #   for p in (r'<script type="application/ld\+json">(.*?)</script>',
  #             r'<script type="application/json" id="store-data">(.*?)</script>'):
  #       b=re.search(p,h,re.S).group(1).encode()
  #       print('sha256-'+base64.b64encode(hashlib.sha256(b).digest()).decode())
  #   EOF
  # api.matthewjamison.dev is the store worker: connect-src for the checkout
  # POST, media-src for the /p/{slug}/{NN} preview streams. Album art is
  # self-hosted under /assets/covers/, so img-src is back to 'self'.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-zGdcM3cD/rgIg2O6ovTJcFQ/KFe+zcFDhgEYH75jLDA=' 'sha256-M1GoZRETYTKm52cLLG8yWfOgQO/UVkAXw3mxnKTky5I=' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self' https://api.matthewjamison.dev; connect-src 'self' https://cloudflareinsights.com https://api.matthewjamison.dev; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; require-trusted-types-for 'script'

# content-stable: fonts, video, and the retired orb files never change in place
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# unversioned at the root, so revalidate rather than pin for a year
/style.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/script.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# the release pages' buy button — same posture as script.js
/release.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# the blog pages' avatar/reduce-motion + copy-link handling, and the subscribe
# form shared by the home page and every post — same posture as script.js
/blog.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/subscribe.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# regenerated on every deploy; a reader polling it wants the new one, not a
# week-old copy
/feed.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ── games routes ─────────────────────────────────────────────────────────
# Vendored third-party games are framed by index.html only. The site-wide
# strict CSP + X-Frame-Options: DENY are detached per game route; each slug
# carries its own least-privilege policy derived from its vendor-time audit
# (see docs/superpowers/specs/2026-08-24-games-section-design.md §4a).
# Trusted Types are deliberately NOT enforced here — the games use innerHTML
# internally; exfiltration is capped by connect-src/form-action instead.

# _test is the Stage 0 lifecycle test page (kept deployed: it is the
# reference harness for the overlay contract). It is no longer a tile on the
# grid — reach it by direct URL.
/games/_test/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src data:; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex

# 2048 — gabrielecirulli/2048 @ 478b6ec, MIT. Vendor-time audit: no eval/new
# Function, no document.write, no inline <script>/<style>, no style="" attrs,
# no fetch/XHR/WebSocket/sendBeacon, no <form>, no audio. So connect-src and
# media-src are left to fall through to default-src 'none'. font-src 'self' IS
# required: style/main.css @imports style/fonts/clear-sans.css, which loads the
# bundled Clear Sans faces via @font-face. img-src 'self' covers favicon.ico
# and the meta/ apple-touch images.
/games/2048/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex

/games/2048/js/*
  Cache-Control: public, max-age=31536000, immutable

/games/2048/style/*
  Cache-Control: public, max-age=31536000, immutable

# tiny platformer — jakesgordon/javascript-tiny-platformer @ 50cbd06c, MIT.
# Vendor-time audit: no eval/new Function, no document.write, no style=""
# attrs, no <form>, no storage APIs, no audio/video, no external hosts (the
# only http(s):// strings are two source-comment credits). The one inline
# <style> block was externalized to platformer.css, so style-src 'self' covers
# the whole page. The vendored FPSMeter HUD was removed (owner call), so there
# is no longer any script writing element.style. connect-src 'self' IS
# required: platformer.js fetches level.json over same-origin XMLHttpRequest
# at startup. img-src 'self' is
# NOT for the game — nothing loads an image (the map is drawn with fillRect;
# tiles.png ships only because level.json names it as its Tiled tileset, and
# is never requested) — it is for the browser's favicon probe, which logs a
# CSP violation on direct navigation to the route. font-src and media-src are
# omitted deliberately — there is no @font-face and there is no sound. They
# fall through to default-src 'none'.
/games/tiny-platformer/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex

# The game's assets all sit in the slug root next to index.html, so they are
# pinned per file rather than by directory — index.html itself must stay
# revalidatable.
/games/tiny-platformer/platformer.js
  Cache-Control: public, max-age=31536000, immutable

/games/tiny-platformer/platformer.css
  Cache-Control: public, max-age=31536000, immutable

/games/tiny-platformer/level.json
  Cache-Control: public, max-age=31536000, immutable

/games/tiny-platformer/tiles.png
  Cache-Control: public, max-age=31536000, immutable

# floppy bird — nebez/floppybird @ efd2c7f7, Apache-2.0 (code). Vendor-time
# audit: no inline <script>/<style> blocks, no document.write, no <form>. The
# only fetch is main.js loading its five same-origin sfx buffers for Web Audio
# (connect-src 'self'); buzz and its media elements are gone, so media-src is
# dropped. No XHR/WebSocket/sendBeacon. The upstream third-party analytics <script
# src="https://yummy.nebez.dev/script.js"> was deleted, so no external host is
# referenced anywhere. The one style="" attribute (the pipe heights, built as
# an HTML string in js/main.js) is gone — the heights are applied via CSSOM
# (element.style), which style-src does not gate — so style-src 'self' covers
# the whole page. img-src 'self' IS required twice over: css/main.css has ten
# url('../assets/*.png')
# backgrounds, and main.js appends <img> tags for the score digits, medals and
# replay button. connect-src 'self' IS required: main.js fetches
# assets/sounds/*.{ogg,m4a} as ArrayBuffers to decode into Web Audio buffers.
# media-src and font-src are omitted deliberately — no media element ever loads
# a resource (the one canPlayType() probe element never gets a src) and the only
# font-family is `monospace`. They fall through to default-src 'none'. jQuery 1.10.2 contains an eval() inside
# globalEval, reachable only from .html()/ajax script injection, neither of
# which this game uses: 'unsafe-eval' is NOT granted.
/games/floppybird/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex

# This game keeps its runtime in three directories, so the cache pins are
# per-directory (index.html at the slug root stays revalidatable).
/games/floppybird/js/*
  Cache-Control: public, max-age=31536000, immutable

/games/floppybird/css/*
  Cache-Control: public, max-age=31536000, immutable

/games/floppybird/assets/*
  Cache-Control: public, max-age=31536000, immutable

# sandspiel — MaxBittker/sandspiel @ dc77827b, MIT. Vendored from a LOCAL
# webpack build of an offline-sandbox source tree: the AdSense/GA/Sentry/
# a.sandspiel.club tags, the Firebase community gallery (upload/browse/vote/
# sign-in) and the workbox service worker were all removed before building, so
# the bundle references no external host. Vendor-time audit of the SHIPPED
# bytes: no document.write, no <form>, no fetch/XHR/WebSocket/sendBeacon, no
# SharedArrayBuffer (0 hits — so NO COOP/COEP is needed and the games page is
# not cross-origin isolated), no inline <script>, no style="" attrs.
#
# Per-directive evidence — this policy is looser than the other three games in
# exactly two places, both forced by the vendored bundle and both verified by
# CSP replay rather than assumed:
#   script-src 'self'          the two hashed chunks + ../mj-mute.js
#   script-src 'unsafe-eval'   REQUIRED, and not optional: regl 1.7.0 compiles
#                              every WebGL draw command by string codegen —
#                              `Function.apply(null, args.concat(src))` in
#                              931.*.js. Without it the fluid/render layer
#                              throws at boot and the game renders NOTHING
#                              (verified: 0 buttons mounted). regl is the
#                              renderer, so this cannot be stripped short of
#                              replacing it. Exfiltration stays capped by
#                              connect-src 'self' + form-action 'none'.
#                              OWNER RULING (2026-08-25): accepted — earned by
#                              regl 1.7.0's Function()-based WebGL command
#                              codegen (blank page without it); scoped to this
#                              slug only, never the site policy.
#   script-src 'wasm-unsafe-eval'  the falling-sand crate is WebAssembly.
#                              Kept explicit even though 'unsafe-eval' implies
#                              it, so the wasm requirement survives any later
#                              tightening that drops 'unsafe-eval'.
#   style-src 'self'           styles.css
#   style-src 'sha256-NOys…'   dat.gui ships its CSS inside the JS bundle and
#                              style-loader injects it as a runtime <style>
#                              element (5852 bytes, injected twice, identical).
#                              Hash-pinned rather than granting 'unsafe-inline'
#                              — same treatment as the JSON-LD block on the main
#                              page. Recompute if the bundle is ever rebuilt.
#   img-src 'self'             the browser's favicon probe (the vendored page
#                              ships no <link rel=icon>, same as tiny-platformer)
#   img-src blob:              the paste-an-SVG affordance: 86.*.js does
#                              `img.src = URL.createObjectURL(blob)` and draws
#                              the result to the canvas. Local only — the blob
#                              is built from the user's own clipboard, never
#                              fetched. data: is NOT granted: the only data:
#                              URIs in the bundle are inside the dat.gui CSS,
#                              which is display:none upstream.
#   font-src 'self'            @font-face for the self-hosted Inconsolata 400
#                              (assets/fonts/, SIL OFL) that replaced the
#                              upstream Google Fonts <link>
#   connect-src 'self'         webpack instantiates the wasm via fetch()
#   media-src                  omitted deliberately — Sandspiel has NO audio at
#                              all (0 hits for AudioContext/new Audio/media
#                              files), so mj-mute.js is inert here and this
#                              falls through to default-src 'none'
/games/sandspiel/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'sha256-NOysBCqoEZQ4w+cB7d5fekIXPgoo1DEVyHhO0OEBfD4='; img-src 'self' blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex

# webpack content-hashes every emitted asset name, so the chunks, the wasm and
# the font are safe to pin forever — a rebuild changes the filename. index.html
# and styles.css sit at the slug root and are NOT hashed, so they are pinned per
# file and the entry HTML stays revalidatable.
/games/sandspiel/86.e096e8a7eaac6b8de58d.js
  Cache-Control: public, max-age=31536000, immutable

/games/sandspiel/931.ef9519c080d98187b4b3.js
  Cache-Control: public, max-age=31536000, immutable

/games/sandspiel/main.c30c08e17d627644ef6c.js
  Cache-Control: public, max-age=31536000, immutable

/games/sandspiel/e30295bd182820ced6dd.module.wasm
  Cache-Control: public, max-age=31536000, immutable

/games/sandspiel/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
