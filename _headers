# Cloudflare Pages headers. Applied at the edge only — a local static server
# ignores this file, so header audits must run against the deployed site.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # Enforcing. Four Cloudflare zone features inject script that cannot satisfy
  # this policy, and all four are off: Bot Fight Mode, JavaScript Detections
  # (inline + nonce-less + innerHTML), Email Address Obfuscation (its decoder
  # uses innerHTML, so with Trusted Types on it left mailto: links rendering as
  # broken placeholder text), and Rocket Loader. Turning any of them back on
  # breaks either that feature or this policy — Cloudflare's own answer is a
  # per-request CSP nonce, which _headers cannot mint (it would need a Pages
  # Function). Web Analytics is the exception: its beacon host is allowed below
  # rather than disabled.
  # Two sha256 sources, both for inline *data* blocks in index.html: the
  # application/ld+json block, and the application/json store-data block that
  # carries the track lists. Neither is executable, but both are pinned so the
  # policy stays honest — recompute a hash whenever its block's bytes change:
  #   python3 - <<'EOF'
  #   import re,hashlib,base64
  #   h=open('index.html',encoding='utf-8').read()
  #   for p in (r'<script type="application/ld\+json">(.*?)</script>',
  #             r'<script type="application/json" id="store-data">(.*?)</script>'):
  #       b=re.search(p,h,re.S).group(1).encode()
  #       print('sha256-'+base64.b64encode(hashlib.sha256(b).digest()).decode())
  #   EOF
  # api.matthewjamison.dev is the store worker: connect-src for the checkout
  # POST, media-src for the /p/{slug}/{NN} preview streams. Album art is
  # self-hosted under /assets/covers/, so img-src is back to 'self'.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-LorUKhdE230pyYrtubteWlLKpJJjmStnIhoRWhdnwI8=' 'sha256-H53oT+0hTC5j7Ftmwgdj9bs4s7FAeO9Rcfjjf27Wqeg=' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self' https://api.matthewjamison.dev; connect-src 'self' https://cloudflareinsights.com https://api.matthewjamison.dev; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; require-trusted-types-for 'script'

# content-stable: fonts, video, and the retired orb files never change in place
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# unversioned at the root, so revalidate rather than pin for a year
/style.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/script.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# ── games routes ─────────────────────────────────────────────────────────
# Vendored third-party games are framed by index.html only. The site-wide
# strict CSP + X-Frame-Options: DENY are detached per game route; each slug
# carries its own least-privilege policy derived from its vendor-time audit
# (see docs/superpowers/specs/2026-08-24-games-section-design.md §4a).
# Trusted Types are deliberately NOT enforced here — the games use innerHTML
# internally; exfiltration is capped by connect-src/form-action instead.

# _test is the Stage 0 lifecycle test page (kept deployed: it is the
# reference harness for the overlay contract).
/games/_test/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; media-src data:; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex
